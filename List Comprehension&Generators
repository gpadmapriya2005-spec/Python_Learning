# l=[3,4,3,5,6,7,6]
l = [3, 4, 3, 5, 6, 7, 6]

# List comprehension
list1 = [x for x in l]
print(list1)

# Set comprehension
set1 = {x for x in l}
print(set1)

# Dictionary comprehension
dict1 = {x: x*x for x in l}
print(dict1)

